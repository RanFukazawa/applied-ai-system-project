flowchart TD
    subgraph Input["Input"]
        U[Owner, Pet, Task data<br/>entered via app.py or main.py]
    end

    subgraph Agent["Agent - Scheduler (pawpal_system.py)"]
        G[generate_plan<br/>sort by priority, duration,<br/>fit to available hours]
        C[detect_conflicts<br/>attention-aware check]
        R[revise_plan<br/>shift lower-priority or<br/>shorter-duration task]
        G --> C
        C -->|conflict found| R
        R --> C
        C -->|no conflict or<br/>N attempts reached| FIN[finalize plan<br/>+ attempt log]
    end

    subgraph Output["Output"]
        O[Plan, reasoning, conflict<br/>warnings shown in app.py]
    end

    subgraph Testing["Evaluator / Tester (tests/test_pawpal.py)"]
        T1[Regression tests:<br/>attention classification,<br/>conflict detection fix]
        T2[Convergence tests:<br/>fixable resolves,<br/>unfixable terminates cleanly]
        T3[Determinism test:<br/>same input, same output]
    end

    subgraph Human["Human in the loop"]
        H[Owner reviews plan,<br/>edits tasks or availability]
    end

    U --> G
    FIN --> O
    O --> H
    H -->|revised input| U
    Agent -.validated by.-> Testing